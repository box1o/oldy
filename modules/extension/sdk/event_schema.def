// Canonical raw ABI v2 application event list.
// Every payload starts with woki_ext_event_metadata_t encoded by
// woki_ext_decode_event_metadata. Event-specific fields follow at
// WOKI_EXT_EVENT_METADATA_SIZE.
// WOKI_EXT_EVENT(CppName, C_NAME, c_name, stable_id, payload_layout)
WOKI_EXT_EVENT(WindowClosed, WINDOW_CLOSED, window_closed, 1, metadata)
WOKI_EXT_EVENT(WindowResized, WINDOW_RESIZED, window_resized, 2, size)
WOKI_EXT_EVENT(WindowFocused, WINDOW_FOCUSED, window_focused, 3, metadata)
WOKI_EXT_EVENT(WindowLostFocus, WINDOW_LOST_FOCUS, window_lost_focus, 4, metadata)
WOKI_EXT_EVENT(WindowMoved, WINDOW_MOVED, window_moved, 5, position)
WOKI_EXT_EVENT(WindowMinimized, WINDOW_MINIMIZED, window_minimized, 6, metadata)
WOKI_EXT_EVENT(WindowMaximized, WINDOW_MAXIMIZED, window_maximized, 7, metadata)
WOKI_EXT_EVENT(WindowRestored, WINDOW_RESTORED, window_restored, 8, metadata)
WOKI_EXT_EVENT(FramebufferResized, FRAMEBUFFER_RESIZED, framebuffer_resized, 9, size)
WOKI_EXT_EVENT(KeyPressed, KEY_PRESSED, key_pressed, 100, key_pressed)
WOKI_EXT_EVENT(KeyReleased, KEY_RELEASED, key_released, 101, key_released)
WOKI_EXT_EVENT(PointerMoved, POINTER_MOVED, pointer_moved, 150, pointer)
WOKI_EXT_EVENT(Scrolled, SCROLLED, scrolled, 151, scroll)
WOKI_EXT_EVENT(PointerDown, POINTER_DOWN, pointer_down, 152, pointer)
WOKI_EXT_EVENT(PointerUp, POINTER_UP, pointer_up, 153, pointer)
WOKI_EXT_EVENT(PointerCancel, POINTER_CANCEL, pointer_cancel, 154, pointer)
WOKI_EXT_EVENT(PointerEntered, POINTER_ENTERED, pointer_entered, 155, pointer)
WOKI_EXT_EVENT(PointerLeft, POINTER_LEFT, pointer_left, 156, pointer)
WOKI_EXT_EVENT(WindowScaleChanged, WINDOW_SCALE_CHANGED, window_scale_changed, 157, scale)
WOKI_EXT_EVENT(TextInput, TEXT_INPUT, text_input, 160, text)
WOKI_EXT_EVENT(TextCompositionStarted, TEXT_COMPOSITION_STARTED, text_composition_started, 161, composition)
WOKI_EXT_EVENT(TextCompositionUpdated, TEXT_COMPOSITION_UPDATED, text_composition_updated, 162, composition)
WOKI_EXT_EVENT(TextCompositionCommitted, TEXT_COMPOSITION_COMMITTED, text_composition_committed, 163, composition)
WOKI_EXT_EVENT(TextCompositionCanceled, TEXT_COMPOSITION_CANCELED, text_composition_canceled, 164, composition)
WOKI_EXT_EVENT(Tap, TAP, tap, 180, gesture)
WOKI_EXT_EVENT(DoubleTap, DOUBLE_TAP, double_tap, 181, gesture)
WOKI_EXT_EVENT(LongPress, LONG_PRESS, long_press, 182, gesture)
WOKI_EXT_EVENT(Pan, PAN, pan, 183, gesture)
WOKI_EXT_EVENT(Pinch, PINCH, pinch, 184, pinch)
WOKI_EXT_EVENT(Rotate, ROTATE, rotate, 185, rotate)
WOKI_EXT_EVENT(ViewportResized, VIEWPORT_RESIZED, viewport_resized, 204, size)
WOKI_EXT_EVENT(AppShutdown, APP_SHUTDOWN, app_shutdown, 303, metadata)
WOKI_EXT_EVENT(AppSuspend, APP_SUSPEND, app_suspend, 304, metadata)
WOKI_EXT_EVENT(AppResume, APP_RESUME, app_resume, 305, metadata)
WOKI_EXT_EVENT(GamepadConnected, GAMEPAD_CONNECTED, gamepad_connected, 400, gamepad_connection)
WOKI_EXT_EVENT(GamepadDisconnected, GAMEPAD_DISCONNECTED, gamepad_disconnected, 401, device)
WOKI_EXT_EVENT(GamepadButtonChanged, GAMEPAD_BUTTON_CHANGED, gamepad_button_changed, 402, gamepad_button)
WOKI_EXT_EVENT(GamepadAxisChanged, GAMEPAD_AXIS_CHANGED, gamepad_axis_changed, 403, gamepad_axis)
WOKI_EXT_EVENT(JoystickButtonChanged, JOYSTICK_BUTTON_CHANGED, joystick_button_changed, 404, joystick_button)
WOKI_EXT_EVENT(JoystickAxisChanged, JOYSTICK_AXIS_CHANGED, joystick_axis_changed, 405, joystick_axis)
WOKI_EXT_EVENT(JoystickHatChanged, JOYSTICK_HAT_CHANGED, joystick_hat_changed, 406, joystick_hat)
WOKI_EXT_EVENT(MonitorConnected, MONITOR_CONNECTED, monitor_connected, 450, text)
WOKI_EXT_EVENT(MonitorDisconnected, MONITOR_DISCONNECTED, monitor_disconnected, 451, text)
WOKI_EXT_EVENT(FilesDropped, FILES_DROPPED, files_dropped, 452, text_list)
WOKI_EXT_EVENT(WindowRefreshRequested, WINDOW_REFRESH_REQUESTED, window_refresh_requested, 453, metadata)
WOKI_EXT_EVENT(PlatformError, PLATFORM_ERROR, platform_error, 454, platform_error)
