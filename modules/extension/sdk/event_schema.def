// Canonical raw ABI v1 application event list.
// WOKI_EXT_EVENT(CppName, C_NAME, c_name, stable_id, payload_layout)
WOKI_EXT_EVENT(WindowClosed, WINDOW_CLOSED, window_closed, 1, empty)
WOKI_EXT_EVENT(WindowResized, WINDOW_RESIZED, window_resized, 2, size)
WOKI_EXT_EVENT(WindowFocused, WINDOW_FOCUSED, window_focused, 3, empty)
WOKI_EXT_EVENT(WindowLostFocus, WINDOW_LOST_FOCUS, window_lost_focus, 4, empty)
WOKI_EXT_EVENT(WindowMoved, WINDOW_MOVED, window_moved, 5, position)
WOKI_EXT_EVENT(WindowMinimized, WINDOW_MINIMIZED, window_minimized, 6, empty)
WOKI_EXT_EVENT(WindowMaximized, WINDOW_MAXIMIZED, window_maximized, 7, empty)
WOKI_EXT_EVENT(WindowRestored, WINDOW_RESTORED, window_restored, 8, empty)
WOKI_EXT_EVENT(KeyPressed, KEY_PRESSED, key_pressed, 100, key_pressed)
WOKI_EXT_EVENT(KeyReleased, KEY_RELEASED, key_released, 101, key_released)
WOKI_EXT_EVENT(KeyTyped, KEY_TYPED, key_typed, 102, key_typed)
WOKI_EXT_EVENT(MouseScrolled, MOUSE_SCROLLED, mouse_scrolled, 151, mouse_scrolled)
WOKI_EXT_EVENT(MouseButtonPressed, MOUSE_BUTTON_PRESSED, mouse_button_pressed, 152, mouse_button)
WOKI_EXT_EVENT(MouseButtonReleased, MOUSE_BUTTON_RELEASED, mouse_button_released, 153, mouse_button)
WOKI_EXT_EVENT(MouseButtonClicked, MOUSE_BUTTON_CLICKED, mouse_button_clicked, 154, mouse_button)
WOKI_EXT_EVENT(MouseEntered, MOUSE_ENTERED, mouse_entered, 155, empty)
WOKI_EXT_EVENT(MouseLeft, MOUSE_LEFT, mouse_left, 156, empty)
WOKI_EXT_EVENT(WindowScaleChanged, WINDOW_SCALE_CHANGED, window_scale_changed, 157, scale)
WOKI_EXT_EVENT(ViewportResized, VIEWPORT_RESIZED, viewport_resized, 204, size)
WOKI_EXT_EVENT(AppShutdown, APP_SHUTDOWN, app_shutdown, 303, empty)
WOKI_EXT_EVENT(AppSuspend, APP_SUSPEND, app_suspend, 304, empty)
WOKI_EXT_EVENT(AppResume, APP_RESUME, app_resume, 305, empty)
