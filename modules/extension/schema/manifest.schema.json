{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woki.local/schemas/wokiext-manifest.schema.json",
  "title": "Woki extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "apiVersion", "runtime", "permissions"],
  "allOf": [
    {
      "if": {
        "required": ["activation"],
        "properties": {
          "activation": {
            "required": ["events"],
            "properties": { "events": { "minItems": 1 } }
          }
        }
      },
      "then": {
        "properties": {
          "permissions": { "contains": { "const": "events" } }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
      "description": "Reverse-DNS extension id. Must match installed package directory."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "apiVersion": { "type": "integer", "const": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wasm"],
      "properties": {
        "wasm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "default": "extension.wasm",
          "pattern": "^(?!/)(?!.*[\\\\:])(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["log", "paths", "storage", "config", "events"]
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declarative activation. When omitted, the extension does not activate at startup, on ticks, or for application events; contributed commands still activate it lazily.",
      "properties": {
        "startup": { "type": "boolean", "default": false },
        "tick": { "type": "boolean", "default": false },
        "events": {
          "type": "array",
          "default": [],
          "maxItems": 22,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "window.closed", "window.resized", "window.focused", "window.lost-focus", "window.moved", "window.minimized", "window.maximized", "window.restored",
              "key.pressed", "key.released", "key.typed", "mouse.scrolled", "mouse-button.pressed", "mouse-button.released", "mouse-button.clicked", "mouse.entered", "mouse.left",
              "window.scale-changed", "viewport.resized", "app.shutdown", "app.suspend", "app.resume"
            ]
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 256 },
              "category": { "type": "string", "maxLength": 128 }
            }
          }
        }
      }
    }
  }
}
