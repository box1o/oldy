{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woki.local/schemas/wokiext-manifest.schema.json",
  "title": "Woki extension manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "apiVersion", "runtime", "permissions"],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
      "description": "Reverse-DNS extension id. Must match installed package directory."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "apiVersion": { "type": "integer", "const": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wasm"],
      "properties": {
        "wasm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "default": "extension.wasm",
          "pattern": "^(?!/)(?!.*[\\\\:])(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["log", "paths", "storage", "config", "events"]
      }
    },
    "libraries": {
      "type": "array",
      "description": "Curated Woki libraries compiled for and statically linked into the Wasm guest.",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["math", "ecs"] }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declarative startup and tick behavior. Extensions requesting the events permission activate on the first supported public application event; contributed commands activate lazily.",
      "properties": {
        "startup": { "type": "boolean", "default": false },
        "tick": { "type": "boolean", "default": false }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 256 },
              "category": { "type": "string", "maxLength": 128 }
            }
          }
        }
      }
    }
  }
}
