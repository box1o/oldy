{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woki.local/schemas/woki-gpu-struct-v1.schema.json",
  "title": "Woki GPU struct v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "address_space", "layout_class", "fields"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "address_space": { "enum": ["uniform", "storage"] },
    "layout_class": { "const": "wgsl-host-shareable" },
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": { "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "type": { "$ref": "#/$defs/type" } }
      }
    }
  },
  "$defs": {
    "type": {
      "oneOf": [
        { "enum": ["f32", "i32", "u32"] },
        { "type": "object", "additionalProperties": false, "required": ["type", "element", "width"], "properties": { "type": { "const": "vector" }, "element": { "enum": ["f32", "i32", "u32"] }, "width": { "type": "integer", "minimum": 2, "maximum": 4 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "columns", "rows"], "properties": { "type": { "const": "matrix" }, "element": { "const": "f32" }, "columns": { "type": "integer", "minimum": 2, "maximum": 4 }, "rows": { "type": "integer", "minimum": 2, "maximum": 4 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "element", "count"], "properties": { "type": { "const": "array" }, "element": { "$ref": "#/$defs/type" }, "count": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "name"], "properties": { "type": { "const": "ref" }, "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "size"], "properties": { "type": { "const": "padding" }, "size": { "type": "integer", "minimum": 4, "multipleOf": 4 } } }
      ]
    }
  }
}
